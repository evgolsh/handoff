{
  // Handoff: hosted MCP service on Cloudflare Workers. One deployment profile (Workers + D1 + R2).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handoff",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Invocation logs record each request URL, which can carry upload and download tickets. Keep only our own logs.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handoff",
      // This deployment's database. The Deploy to Cloudflare button and npm run setup put your own id here.
      "database_id": "428963e4-d377-46f7-b0c5-3d36d5bad609",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "handoff-attachments" }],
  // Static files (fonts, from npm run assets). Served before the Worker for exact paths.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // The deployed version id and time, shown on the console's Ops page.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Cleanup, hourly. Each run is bounded (src/env.ts cleanupBatch, cleanupRounds) and logs backlog: true if it stopped early.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    // Public origin of this Worker, without a trailing slash. Empty: the origin each request came to (the
    // workers.dev address, or a custom domain). The MCP endpoint is that origin + "/mcp", and the Worker is its own
    // OAuth 2.1 issuer there (src/auth/builtin.ts). Set it only to pin one origin when the Worker has several.
    "PUBLIC_URL": "",
    // "production" or "dev". Only "dev" honours DEV_TOKENS (local wrangler dev, never deployed).
    "HANDOFF_ENV": "production",
    // Hard bound on one attachment, in bytes (25 MiB).
    "MAX_ATTACHMENT_BYTES": "26214400",
    // Comma-separated hostnames allowed for server-side imports of host file URLs (OpenAI `files`); "*.x.com"
    // matches subdomains. Empty = imports off. The refusal names the host, so the first ChatGPT test shows what to add.
    "IMPORT_HOST_ALLOWLIST": ""
  }
}
